{%- comment -%}
  Layout limpio para la landing de ODC Drop.
  Sin menú, sin header ni footer del tema: cero distracciones, más conversión y carga más rápida.
  Mantiene todo lo que Shopify necesita (analytics, píxeles, banner de cookies, apps) vía content_for_header.
{%- endcomment -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#120B1E">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ page_title }}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:type" content="website">
    <meta property="og:description" content="{{ page_description | default: shop.description | escape }}">
    {%- if page_image -%}
      <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
      <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
    {%- endif -%}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page_title | escape }}">
    <meta name="twitter:description" content="{{ page_description | default: shop.description | escape }}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    {{ content_for_header }}

    <style>
      html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
      body{margin:0;background:#FBF6ED;overflow-x:hidden}
      @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
      .odc-skip{position:absolute;left:-9999px;top:0;z-index:100;background:#D7FF3F;color:#1A1420;padding:10px 16px;border-radius:0 0 10px 0;font:700 14px/1.2 system-ui,sans-serif}
      .odc-skip:focus{left:0}
    </style>
  </head>

  <body>
    <a class="odc-skip" href="#MainContent">Saltar al contenido</a>
    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
