      <span class="eyebrow">{{ s.faq_eyebrow }}</span>
      <h2 class="headline">{{ s.faq_title }}</h2>
      <div class="faq-list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' -%}
            <details {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question }}<span class="chev" aria-hidden="true">{{ icon_plus }}</span></summary>
              <div class="ans">{{ block.settings.answer | replace: '[precio]', price_str | replace: '[cuotas]', cuotas_str }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="final section-pad" data-odc-final>
