      <span class="eyebrow">{{ s.steps_eyebrow }}</span>
      <h2 class="headline">{{ s.steps_title }}</h2>
      <div class="steps-grid">
        {%- assign step_i = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            {%- assign step_i = step_i | plus: 1 -%}
            <div class="step" {{ block.shopify_attributes }}><span class="snum" aria-hidden="true">0{{ step_i }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="faq section-pad" style="padding-top:0">
