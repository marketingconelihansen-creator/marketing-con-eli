        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        {%- if story_b.settings.photo_badge != blank -%}<span class="photo-badge">{{ story_b.settings.photo_badge }}</span>{%- endif -%}
