        <div class="story-text">{{ story_b.settings.story_text }}</div>
        {%- if story_b.settings.story_signature != blank -%}<cite>{{ story_b.settings.story_signature }}</cite>{%- endif -%}
        {%- if story_b.settings.story_closer != blank -%}<div class="closer">{{ story_b.settings.story_closer | replace: '[precio]', price_str }}</div>{%- endif -%}
        <div style="margin-top:26px">
          <a class="btn" href="{{ cta_url }}">{{ story_b.settings.cta_story | replace: '[precio]', price_str }}</a>
