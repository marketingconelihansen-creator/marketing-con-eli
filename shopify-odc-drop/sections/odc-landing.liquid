<script>
(function(){
  var root = document.getElementById('odc-{{ section.id }}');
  if (!root) return;
  var reduce = window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  var canTilt = window.matchMedia('(hover:hover) and (pointer:fine)').matches && !reduce;

  /* ---- Cuenta regresiva a una fecha REAL (igual para todos) ---- */
  var bar = root.querySelector('.announce');
  var dl = root.getAttribute('data-deadline');
  if (bar && dl) {
    var deadline = Date.parse(dl);
    var el = {};
    ['d','dsep','h','m','s'].forEach(function(k){ el[k] = root.querySelector('[data-cd="' + k + '"]'); });
    var pad = function(n){ return (n < 10 ? '0' : '') + n; };
    var timer;
    var tick = function(){
      var diff = deadline - Date.now();
      if (isNaN(deadline) || diff <= 0) { bar.classList.add('is-expired'); clearInterval(timer); return; }
      var d = Math.floor(diff / 86400000);
      var h = Math.floor((diff % 86400000) / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      if (d > 0) { el.d.hidden = false; el.dsep.hidden = false; el.d.textContent = d + 'd'; }
      else { el.d.hidden = true; el.dsep.hidden = true; }
      el.h.textContent = pad(h); el.m.textContent = pad(m); el.s.textContent = pad(s);
    };
    tick();
    timer = setInterval(tick, 1000);
  }

  /* ---- Inclinación 3D del celular (solo desktop) ---- */
  var stage = root.querySelector('[data-odc-stage]');
  var phone = root.querySelector('[data-odc-phone]');
  if (canTilt && stage && phone) {
    stage.addEventListener('mousemove', function(e){
      var r = stage.getBoundingClientRect();
      var px = (e.clientX - r.left) / r.width - 0.5;
      var py = (e.clientY - r.top) / r.height - 0.5;
      phone.style.transform = 'translate(-50%,-50%) rotateY(' + (-14 + px * 18) + 'deg) rotateX(' + (6 - py * 14) + 'deg)';
    });
    stage.addEventListener('mouseleave', function(){ phone.style.transform = ''; });
  }

  /* ---- Calculadora ---- */
  var PRICE = parseFloat(root.getAttribute('data-price')) || 0;
  var RATE = parseFloat(root.getAttribute('data-ars-rate')) || 0;
  var range = root.querySelector('[data-odc-range]');
  if (range) {
    var salesVal = root.querySelector('[data-odc-sales]');
    var resUsd = root.querySelector('[data-odc-usd]');
    var resArs = root.querySelector('[data-odc-ars]');
    var bills = root.querySelectorAll('.bill');
    var fmt = function(n){ return Math.round(n).toLocaleString('es-AR'); };
    var update = function(){
      var n = parseInt(range.value, 10);
      var usd = n * PRICE;
      salesVal.textContent = n;
      resUsd.textContent = '$' + fmt(usd) + ' USD';
      if (resArs && RATE) resArs.textContent = '≈ $' + fmt(usd * RATE) + ' ARS';
      var active = Math.min(bills.length, Math.max(1, Math.ceil(n / 10)));
      for (var i = 0; i < bills.length; i++) bills[i].classList.toggle('active', i < active);
    };
    range.addEventListener('input', update);
    update();
  }

  /* ---- Inclinación de las tarjetas de módulos ---- */
  if (canTilt) {
    root.querySelectorAll('[data-odc-tilt]').forEach(function(card){
      card.addEventListener('mousemove', function(e){
        var r = card.getBoundingClientRect();
        var px = (e.clientX - r.left) / r.width - 0.5;
        var py = (e.clientY - r.top) / r.height - 0.5;
        card.style.transform = 'perspective(600px) rotateY(' + (px * 10) + 'deg) rotateX(' + (-py * 10) + 'deg) translateY(-2px)';
      });
      card.addEventListener('mouseleave', function(){ card.style.transform = ''; });
    });
  }

  /* ---- Botón fijo en celular: aparece al pasar el primer botón y se oculta en el cierre ---- */
  var mcta = root.querySelector('[data-odc-mcta]');
  var heroCta = root.querySelector('[data-odc-hero-cta]');
  var finalSec = root.querySelector('[data-odc-final]');
  if (mcta) {
    var ticking = false;
    var sync = function(){
      ticking = false;
      var vh = window.innerHeight;
      var pastHero = heroCta ? heroCta.getBoundingClientRect().bottom < 0 : window.scrollY > vh;
      var atFinal = finalSec ? finalSec.getBoundingClientRect().top < vh * 0.8 : false;
      mcta.classList.toggle('is-visible', pastHero && !atFinal);
    };
    var onScroll = function(){ if (!ticking) { ticking = true; requestAnimationFrame(sync); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    sync();
  }
})();
</script>

