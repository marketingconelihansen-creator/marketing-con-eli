          {%- if block.type == 'bonus' -%}
            {%- assign bon_i = bon_i | plus: 1 -%}
            <div class="bonus" {{ block.shopify_attributes }}>
              <span class="bn">{% if bon_i < 10 %}0{% endif %}{{ bon_i }}</span>
              <div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
              {%- if block.settings.value > 0 -%}<span class="val">${{ block.settings.value }}</span>{%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="price-card">
        <div>
          <span class="eyebrow">Resumen de tu acceso</span>
          <div class="price-lines">
            <div class="row"><span>{{ s.sum_line_1 }}</span><span>incluido</span></div>
            <div class="row"><span>{{ bonus_count }} bonos de regalo</span><span>${{ bonus_total_str }}</span></div>
            {%- if s.sum_line_2 != blank -%}<div class="row"><span>{{ s.sum_line_2 }}</span><span>incluido</span></div>{%- endif -%}
            {%- if s.sum_line_3 != blank -%}<div class="row"><span>{{ s.sum_line_3 }}</span><span>incluido</span></div>{%- endif -%}
            <div class="tot"><span>Precio regular</span><span>{{ regular_str }}</span></div>
          </div>
        </div>
        <div class="price-right">
