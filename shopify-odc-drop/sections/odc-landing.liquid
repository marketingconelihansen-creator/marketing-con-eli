{%- comment -%}
  ODC Drop — Landing de venta para infoproducto
  Sección autocontenida (CSS + JS + schema). Todo el CSS está encapsulado en .odc
  para que no choque con los estilos del tema.
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  # Bloques únicos (Hero, Números, Calculadora, Historia). Si borrás uno, esa parte se oculta.
  assign hero_b = nil
  assign stats_b = nil
  assign calc_b = nil
  assign story_b = nil
  for block in section.blocks
    case block.type
      when 'hero'
        assign hero_b = block
      when 'stats'
        assign stats_b = block
      when 'calc'
        assign calc_b = block
      when 'story'
        assign story_b = block
    endcase
  endfor

  # ---------- Link de compra ----------
  # Prioridad: 1) el producto elegido en el editor, 2) el primer producto activo de la tienda,
  # 3) el link externo (solo si la tienda no tiene productos). Siempre va DIRECTO al checkout.
  assign odc_product = s.product
  if odc_product == blank
    assign odc_product = collections.all.products.first
  endif
  if odc_product != blank
    assign odc_variant = odc_product.selected_or_first_available_variant
    assign cta_url = routes.cart_url | append: '/' | append: odc_variant.id | append: ':1'
    if s.discount_code != blank
      assign cta_url = cta_url | append: '?discount=' | append: s.discount_code
    endif
  else
    assign cta_url = s.checkout_url
  endif
  if cta_url == blank
    assign cta_url = '#'
  endif

  # ---------- Precios ----------
  assign price_str = '$' | append: s.price_usd
  assign regular_str = '$' | append: s.regular_price_usd
  assign pct_off = 0
  if s.regular_price_usd > 0
    assign pct_paid = s.price_usd | times: 100.0 | divided_by: s.regular_price_usd | round
    assign pct_off = 100 | minus: pct_paid
  endif

  assign cuotas_str = ''
  if s.installments > 1
    assign cuotas_str = s.installments | append: ' cuotas sin interés'
  endif

  # Suma automática del valor de los bonos
  assign bonus_total = 0
  assign bonus_count = 0
  for block in section.blocks
    if block.type == 'bonus'
      assign bonus_total = bonus_total | plus: block.settings.value
      assign bonus_count = bonus_count | plus: 1
    endif
  endfor

  # Conversión a ARS (0 = ocultar)
  assign ars_price = s.price_usd | times: s.ars_rate
  assign ars_cuota = 0
  if s.installments > 1
    assign ars_cuota = ars_price | times: 1.0 | divided_by: s.installments | round
  endif

  # Formato con punto de miles (93900 -> 93.900)
  assign nums = ars_price | append: ',' | append: ars_cuota | append: ',' | append: bonus_total | split: ','
  assign fmt_list = ''
  for raw in nums
    assign n = raw | plus: 0 | floor
    assign mm = n | divided_by: 1000000 | floor
    assign tt = n | modulo: 1000000 | divided_by: 1000 | floor
    assign uu = n | modulo: 1000
    assign tp = tt | plus: 1000 | append: '' | slice: 1, 3
    assign up = uu | plus: 1000 | append: '' | slice: 1, 3
    if mm > 0
      assign fs = mm | append: '.' | append: tp | append: '.' | append: up
    elsif tt > 0
      assign fs = tt | append: '.' | append: up
    else
      assign fs = uu | append: ''
    endif
    assign fmt_list = fmt_list | append: fs | append: '|'
  endfor
  assign fmt = fmt_list | split: '|'
  assign ars_price_str = fmt[0]
  assign ars_cuota_str = fmt[1]
  assign bonus_total_str = fmt[2]

  # Reemplazos disponibles en los textos: [precio] [precio_regular] [descuento] [cuotas]
  assign pct_str = pct_off | append: '%'
-%}

{%- capture odc_fonts -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..900&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,600&family=Space+Mono:wght@400;700&display=swap">
{%- endcapture -%}
{{ odc_fonts }}

<style>
  /* ============ TOKENS (encapsulados en .odc) ============ */
  .odc{
    --bg:#FBF6ED;--bg-dark:#120B1E;--bg-dark-2:#1A1030;
    --ink:#1A1420;--ink-soft:#332B42;--ink-inverse:#F7F2FF;
    --muted:#6E6579;--muted-inverse:#BBAFD1;
    --lime:#D7FF3F;--lime-deep:#A9CC1E;
    --magenta:#FF2E8B;--magenta-deep:#C4116A;
    --violet:#7A4DFF;--violet-deep:#3A1D7A;
    --card:#FFFFFF;--card-dark:#1F1533;
    --border:rgba(26,20,32,0.10);--border-dark:rgba(247,242,255,0.14);
    --shadow:26 20 32;
    --radius-lg:28px;--radius-md:18px;--radius-sm:10px;
    --maxw:1180px;
    background:var(--bg);color:var(--ink);
    font-family:"Plus Jakarta Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
    font-size:16px;line-height:1.5;letter-spacing:normal;
    overflow-x:clip;
    -webkit-font-smoothing:antialiased;
  }
  .odc *,.odc *::before,.odc *::after{box-sizing:border-box}
  .odc img,.odc svg{max-width:100%;display:block}
  .odc a{color:inherit}
  .odc h1,.odc h2,.odc h3,.odc h4,.odc h5{
    font-family:"Bricolage Grotesque",system-ui,sans-serif;font-weight:800;margin:0;
    text-wrap:balance;letter-spacing:-0.01em;line-height:1.1;color:inherit;text-transform:none;
  }
  .odc p{margin:0}
  .odc .mono{font-family:"Space Mono",ui-monospace,monospace}
  .odc ::selection{background:var(--lime);color:var(--ink)}
  .odc :focus-visible{outline:3px solid var(--magenta);outline-offset:3px;border-radius:4px}

  .odc .wrap{max-width:var(--maxw);margin:0 auto;padding-inline:clamp(20px,5vw,48px)}
  .odc section,.odc header{position:relative}
  .odc .section-pad{padding-block:clamp(64px,9vw,120px)}
  .odc .dark{background:var(--bg-dark);color:var(--ink-inverse)}
  .odc .dark .muted{color:var(--muted-inverse)}
  .odc .muted{color:var(--muted)}

  .odc .eyebrow{
    font-family:"Space Mono",monospace;font-size:0.72rem;letter-spacing:0.16em;text-transform:uppercase;
    font-weight:700;color:var(--magenta);display:inline-flex;align-items:center;gap:8px;
  }
  .odc .eyebrow::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--magenta);box-shadow:0 0 0 4px rgba(255,46,139,0.18)}
  .odc h2.headline{font-size:clamp(1.9rem,4vw,2.7rem);max-width:18ch;margin-top:14px}
  .odc .dark h2.headline{color:var(--ink-inverse)}
  .odc .lede{font-size:clamp(1.02rem,1.6vw,1.15rem);color:var(--muted);max-width:52ch;margin-top:12px}
  .odc .dark .lede{color:var(--muted-inverse)}

  /* ============ BUTTONS ============ */
  .odc .btn{
    display:inline-flex;align-items:center;justify-content:center;gap:10px;
    padding:1.05rem 1.9rem;min-height:52px;border-radius:999px;
    font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:1.02rem;line-height:1.2;
    text-decoration:none;border:none;cursor:pointer;text-align:center;
    background:var(--lime);color:var(--ink);
    box-shadow:0 1px 0 rgba(255,255,255,0.5) inset,0 14px 30px -12px rgba(215,255,63,0.55);
    transition:transform .18s ease,box-shadow .18s ease;
    white-space:normal;max-width:100%;
    -webkit-tap-highlight-color:transparent;
  }
  .odc .btn:hover{transform:translateY(-3px) scale(1.015);box-shadow:0 1px 0 rgba(255,255,255,0.5) inset,0 20px 34px -10px rgba(255,46,139,0.45)}
  .odc .btn:active{transform:translateY(-1px) scale(0.99)}
  .odc .btn-block{width:100%}
  .odc .btn-sub{display:block;margin-top:10px;font-size:0.8rem;color:var(--muted-inverse)}
  .odc section:not(.dark) .btn-sub{color:var(--muted)}

  .odc .trust-row{
    display:flex;flex-wrap:wrap;gap:10px 18px;align-items:center;
    font-family:"Space Mono",monospace;font-size:0.76rem;color:var(--muted-inverse);margin-top:18px;
  }
  .odc .trust-row span{display:inline-flex;align-items:center;gap:6px}
  .odc .trust-row svg{width:13px;height:13px;flex:none;color:var(--lime)}

  /* ============ ANNOUNCEMENT BAR ============ */
  .odc .announce{
    background:linear-gradient(90deg,var(--magenta-deep),var(--magenta) 50%,var(--magenta-deep));
    color:#fff;padding:10px clamp(14px,4vw,24px);
    position:sticky;top:0;z-index:50;
    display:flex;flex-wrap:wrap;gap:8px 18px;align-items:center;justify-content:center;
    text-align:center;font-size:0.82rem;
    box-shadow:0 6px 18px -10px rgba(0,0,0,0.5);
  }
  .odc .announce strong{font-family:"Bricolage Grotesque",sans-serif;font-weight:800}
  .odc .countdown{display:inline-flex;gap:6px;align-items:center;font-family:"Space Mono",monospace;font-weight:700}
  .odc .countdown .t{background:rgba(0,0,0,0.22);border-radius:6px;padding:3px 7px;min-width:2.1em;text-align:center}
  .odc .countdown .sep{opacity:.7}
  .odc .countdown [hidden]{display:none}
  .odc .announce .when-expired{display:none}
  .odc .announce.is-expired .when-live{display:none}
  .odc .announce.is-expired .when-expired{display:inline}

  /* ============ HERO ============ */
  .odc .hero{
    background:
      radial-gradient(60% 55% at 82% 8%,rgba(122,77,255,0.45),transparent 60%),
      radial-gradient(45% 40% at 8% 92%,rgba(255,46,139,0.28),transparent 60%),
      var(--bg-dark);
    color:var(--ink-inverse);
    padding-block:clamp(48px,8vw,96px) clamp(64px,9vw,110px);
    overflow:hidden;
  }
  .odc .blob{position:absolute;border-radius:50%;filter:blur(60px);opacity:.55;pointer-events:none;animation:odcDrift 16s ease-in-out infinite alternate}
  .odc .blob1{width:420px;height:420px;background:var(--violet);top:-140px;right:-120px}
  .odc .blob2{width:300px;height:300px;background:var(--magenta-deep);bottom:-100px;left:-80px;animation-delay:-6s}
  @keyframes odcDrift{from{transform:translate(0,0) scale(1)}to{transform:translate(-26px,30px) scale(1.08)}}

  .odc .hero-grid{display:grid;grid-template-columns:1.05fr 0.95fr;gap:clamp(32px,6vw,64px);align-items:center;position:relative}
  .odc .hero h1{font-size:clamp(2.2rem,5.4vw,3.9rem);color:var(--ink-inverse);margin-top:18px}
  .odc .hero h1 strong,.odc .hero h1 b{color:var(--lime);font-weight:inherit}
  .odc .hero .lede{margin-top:18px;color:var(--muted-inverse);font-size:clamp(1.05rem,1.7vw,1.22rem)}
  .odc .hero .lede strong{color:var(--ink-inverse)}
  .odc .hero-cta{margin-top:30px;display:flex;flex-direction:column;align-items:flex-start}
  .odc .hero-cta .btn-sub strong{color:var(--lime)}

  /* phone mockup */
  .odc .phone-stage{position:relative;height:clamp(380px,44vw,520px);perspective:1400px}
  .odc .phone{
    position:absolute;left:50%;top:50%;width:min(78%,260px);aspect-ratio:9/18.3;
    background:linear-gradient(160deg,#241A3D,#150C28);
    border-radius:38px;border:2px solid rgba(255,255,255,0.14);
    box-shadow:0 40px 80px -24px rgba(0,0,0,0.75),0 0 0 8px rgba(255,255,255,0.03);
    transform:translate(-50%,-50%) rotateY(-14deg) rotateX(6deg);
    transform-style:preserve-3d;transition:transform .25s ease-out;
  }
  .odc .phone::before{content:"";position:absolute;top:14px;left:50%;transform:translateX(-50%);width:36%;height:14px;background:rgba(0,0,0,0.5);border-radius:20px;z-index:2}
  .odc .phone .screen{position:absolute;inset:14px;border-radius:26px;background:linear-gradient(200deg,#3A2568,#160E29 70%);overflow:hidden}
  .odc .screen-glow{position:absolute;inset:0;background:radial-gradient(60% 40% at 30% 20%,rgba(215,255,63,0.25),transparent 60%)}
  .odc .screen-price{position:absolute;top:22%;left:0;right:0;text-align:center;color:var(--lime);font-family:"Space Mono",monospace;font-weight:700;font-size:1.7rem}
  .odc .screen-sub{position:absolute;top:33%;left:0;right:0;text-align:center;color:var(--muted-inverse);font-size:0.68rem;letter-spacing:.08em;text-transform:uppercase}
  .odc .screen-bars{position:absolute;bottom:16%;left:14%;right:14%;display:flex;align-items:flex-end;gap:6px;height:60px}
  .odc .screen-bars i{flex:1;background:linear-gradient(180deg,var(--lime),var(--magenta));border-radius:4px;opacity:.85}

  .odc .toast{
    position:absolute;width:206px;background:rgba(255,255,255,0.98);color:var(--ink);
    border-radius:16px;padding:11px 13px;box-shadow:0 18px 36px -16px rgba(0,0,0,0.55);
    display:flex;gap:10px;align-items:flex-start;font-size:0.78rem;line-height:1.3;
    animation:odcBob 5s ease-in-out infinite;
  }
  .odc .toast .av{width:26px;height:26px;border-radius:50%;flex:none;display:flex;align-items:center;justify-content:center;font-family:"Bricolage Grotesque",sans-serif;font-weight:800;color:#fff;font-size:.75rem}
  .odc .toast b{display:block;font-family:"Bricolage Grotesque",sans-serif;font-size:0.82rem}
  .odc .toast .ok{color:var(--magenta-deep);font-size:.68rem;font-weight:700}
  .odc .toast1{top:6%;left:-6%;--rot:-4deg}
  .odc .toast1 .av{background:var(--violet)}
  .odc .toast2{bottom:16%;right:-10%;animation-delay:-2s;--rot:3deg}
  .odc .toast2 .av{background:var(--magenta)}
  .odc .toast3{top:44%;right:-14%;animation-delay:-3.4s;width:150px;--rot:-2deg}
  .odc .toast3 .av{background:var(--lime-deep)}
  @keyframes odcBob{0%,100%{transform:translateY(0) rotate(var(--rot,0deg))}50%{transform:translateY(-10px) rotate(var(--rot,0deg))}}

  /* ============ STATS ============ */
  .odc .stats{background:var(--bg);padding-block:clamp(40px,6vw,64px)}
  .odc .stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);border:1px solid var(--border);border-radius:var(--radius-md);overflow:hidden}
  .odc .stat{background:var(--card);padding:clamp(20px,3vw,32px);text-align:center}
  .odc .stat .num{font-weight:700;font-size:clamp(1.7rem,3.4vw,2.4rem);line-height:1.1}
  .odc .stat .lbl{margin-top:6px;font-size:0.85rem;color:var(--muted)}

  /* ============ AGITATE ============ */
  .odc .agitate{background:var(--bg-dark-2)}
  .odc .agitate-list{margin-top:40px;display:grid;gap:14px}
  .odc .pain{display:flex;gap:16px;align-items:flex-start;background:var(--card-dark);border:1px solid var(--border-dark);border-radius:var(--radius-md);padding:18px 22px}
  .odc .pain svg{flex:none;margin-top:3px;width:22px;height:22px;color:var(--magenta)}
  .odc .pain p{font-size:1.02rem;color:var(--ink-inverse)}

  /* ============ MODULES ============ */
  .odc .modules-grid{margin-top:44px;display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .odc .mcard{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-md);padding:22px;transition:transform .18s ease,box-shadow .18s ease}
  .odc .mcard:hover{box-shadow:0 22px 40px -20px rgba(var(--shadow),0.35)}
  .odc .mcard .num{font-family:"Space Mono",monospace;font-size:.78rem;color:var(--magenta);font-weight:700}
  .odc .micon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;margin:10px 0 14px;background:linear-gradient(135deg,var(--lime),#f4ffb0);color:var(--ink)}
  .odc .micon svg{width:22px;height:22px}
  .odc .mcard h3{font-size:1.03rem;font-weight:700;font-family:"Plus Jakarta Sans",sans-serif;line-height:1.3}
  .odc .mcard p{margin-top:6px;font-size:.9rem;color:var(--muted)}
  .odc .extra-list{margin-top:16px;display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
  .odc .extra{display:flex;gap:10px;align-items:center;background:var(--card);border:1px dashed rgba(26,20,32,0.22);border-radius:var(--radius-sm);padding:12px 14px;font-size:0.92rem;font-weight:600}
  .odc .extra svg{width:18px;height:18px;color:var(--violet);flex:none}

  /* ============ NOT NEEDED ============ */
  .odc .notneed{background:var(--bg-dark)}
  .odc .notneed-grid{list-style:none;padding:0;margin:36px 0 0;display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
  .odc .nn{display:flex;align-items:center;gap:10px;background:var(--card-dark);border:1px solid var(--border-dark);border-radius:999px;padding:12px 16px;font-size:0.92rem;color:var(--ink-inverse)}
  .odc .nn svg{width:16px;height:16px;color:var(--lime);flex:none}

  /* ============ CALCULATOR ============ */
  .odc .calc{background:var(--bg-dark-2)}
  .odc .calc-wrap{display:grid;grid-template-columns:1fr 0.85fr;gap:clamp(28px,5vw,56px);align-items:center}
  .odc .calc-controls{margin-top:28px;background:var(--card-dark);border:1px solid var(--border-dark);border-radius:var(--radius-md);padding:clamp(18px,4vw,26px)}
  .odc .calc-value{display:flex;align-items:baseline;gap:10px}
  .odc .calc-value .v{font-size:2.6rem;font-weight:700;color:var(--lime);line-height:1}
  .odc .calc-unit{color:var(--muted-inverse);font-size:.9rem}
  .odc input[type="range"]{
    width:100%;margin:18px 0 4px;-webkit-appearance:none;appearance:none;height:6px;border-radius:999px;
    background:linear-gradient(90deg,var(--lime),var(--magenta));outline:none;border:0;padding:0;
    touch-action:pan-y;
  }
  .odc input[type="range"]::-webkit-slider-thumb{-webkit-appearance:none;width:28px;height:28px;border-radius:50%;background:#fff;border:4px solid var(--violet);cursor:pointer;box-shadow:0 6px 14px -4px rgba(0,0,0,0.6)}
  .odc input[type="range"]::-moz-range-thumb{width:28px;height:28px;border-radius:50%;background:#fff;border:4px solid var(--violet);cursor:pointer}
  .odc .calc-result{margin:22px 0;display:grid;gap:8px;border-top:1px dashed var(--border-dark);padding-top:16px}
  .odc .res-row{display:flex;justify-content:space-between;align-items:baseline;gap:12px;color:var(--muted-inverse);font-size:.92rem}
  .odc .res-row.big{color:var(--ink-inverse);font-size:clamp(1.15rem,3.5vw,1.5rem);font-weight:700}
  .odc .res-row.big span:last-child{color:var(--lime)}
  .odc .calc-note{font-size:.72rem;color:var(--muted-inverse);opacity:.8;margin-top:12px}
  .odc .calc-stage{height:clamp(220px,30vw,360px);perspective:900px;display:flex;align-items:flex-end;justify-content:center}
  .odc .bill-stack{position:relative;width:180px;height:100%}
  .odc .bill{
    position:absolute;left:50%;bottom:0;width:170px;height:44px;border-radius:8px;
    background:linear-gradient(135deg,var(--lime),#9be000);border:1px solid rgba(0,0,0,0.15);
    display:flex;align-items:center;justify-content:center;
    font-family:"Space Mono",monospace;font-weight:700;color:var(--violet-deep);
    opacity:0;transform:translate(-50%,0) translateY(20px) rotateX(55deg) rotateZ(calc((var(--i) * 7deg) - 24deg));
    transition:opacity .3s ease,transform .3s ease,bottom .3s ease;
    box-shadow:0 6px 10px -4px rgba(0,0,0,0.5);
  }
  .odc .bill.active{opacity:1;bottom:calc(var(--i) * 20px);transform:translate(-50%,0) rotateX(55deg) rotateZ(calc((var(--i) * 7deg) - 24deg))}

  /* ============ OFFER ============ */
  .odc .offer-grid{margin-top:40px;display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
  .odc .bonus{display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:center;background:var(--card);border:1px solid var(--border);border-radius:var(--radius-md);padding:16px 18px}
  .odc .bonus .bn{font-family:"Space Mono",monospace;font-weight:700;color:var(--violet);font-size:.85rem;background:rgba(122,77,255,0.1);border-radius:8px;padding:4px 8px}
  .odc .bonus h3{font-size:.98rem;margin-bottom:3px;line-height:1.25}
  .odc .bonus p{font-size:.85rem;color:var(--muted)}
  .odc .bonus .val{font-family:"Space Mono",monospace;font-size:.8rem;color:var(--magenta-deep);font-weight:700;white-space:nowrap}

  .odc .price-card{
    margin-top:34px;background:linear-gradient(155deg,var(--violet-deep),var(--bg-dark) 65%);
    border:1px solid var(--border-dark);border-radius:var(--radius-lg);
    padding:clamp(24px,5vw,48px);color:var(--ink-inverse);
    display:grid;grid-template-columns:1.1fr 0.9fr;gap:32px;align-items:center;
  }
  .odc .price-card .eyebrow{color:var(--lime)}
  .odc .price-card .eyebrow::before{background:var(--lime);box-shadow:0 0 0 4px rgba(215,255,63,0.18)}
  .odc .price-lines{display:grid;gap:8px;font-family:"Space Mono",monospace;font-size:.92rem;margin-top:16px}
  .odc .price-lines .row{display:flex;justify-content:space-between;gap:12px;color:var(--muted-inverse);text-align:left}
  .odc .price-lines .tot{border-top:1px dashed var(--border-dark);margin-top:6px;padding-top:10px;display:flex;justify-content:space-between;font-weight:700;color:var(--lime)}
  .odc .price-right{text-align:center}
  .odc .strike{color:var(--muted-inverse);text-decoration:line-through;font-family:"Space Mono",monospace;font-size:1.1rem}
  .odc .big-price{font-family:"Bricolage Grotesque",sans-serif;font-weight:900;font-size:clamp(3.2rem,7vw,4.6rem);color:var(--lime);line-height:1;margin-top:4px}
  .odc .big-price sup{font-size:.4em;top:-1.4em;position:relative;vertical-align:baseline}
  .odc .price-note{font-size:.8rem;color:var(--muted-inverse);margin-top:6px}
  .odc .cuotas{font-size:.95rem;font-weight:700;color:var(--ink);margin-top:14px;background:var(--lime);border-radius:12px;padding:10px 18px;display:inline-block;box-shadow:0 10px 20px -8px rgba(215,255,63,0.5)}
  .odc .secure{margin-top:14px;display:flex;flex-wrap:wrap;justify-content:center;gap:6px 14px;font-size:.74rem;color:var(--muted-inverse);font-family:"Space Mono",monospace}
  .odc .secure span{display:inline-flex;align-items:center;gap:6px}
  .odc .secure svg{width:13px;height:13px;color:var(--lime)}

  /* ============ STORY ============ */
  .odc .story{background:var(--bg)}
  .odc .story-grid{display:grid;grid-template-columns:280px 1fr;gap:clamp(28px,5vw,52px);align-items:start}
  .odc .photo-card{position:relative;perspective:1000px;max-width:320px}
  .odc .photo-card img,.odc .photo-card .placeholder-svg{
    width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;border-radius:var(--radius-md);
    border:6px solid var(--card);box-shadow:0 30px 50px -20px rgba(var(--shadow),0.4);
    transform:rotateZ(-3deg) rotateY(6deg);transition:transform .3s ease;background:#e9e2d6;
  }
  .odc .photo-card:hover img{transform:rotateZ(0) rotateY(0)}
  .odc .photo-badge{position:absolute;bottom:-14px;right:-14px;background:var(--ink);color:var(--ink-inverse);font-family:"Space Mono",monospace;font-size:.72rem;padding:8px 14px;border-radius:999px;box-shadow:0 12px 24px -10px rgba(0,0,0,0.5);border:2px solid var(--lime)}
  .odc .problema{display:block;margin:16px 0;padding:10px 16px;border-radius:var(--radius-sm);background:rgba(255,46,139,0.08);border:1px solid rgba(255,46,139,0.25);font-size:.92rem;font-weight:600;color:var(--magenta-deep)}
  .odc .story-text{font-size:clamp(1.02rem,1.7vw,1.18rem);line-height:1.65}
  .odc .story-text p+p{margin-top:14px}
  .odc .story cite{display:block;margin-top:18px;font-style:normal;font-weight:700;font-family:"Bricolage Grotesque",sans-serif}
  .odc .closer{margin-top:24px;padding:20px 24px;background:var(--card-dark);color:var(--ink-inverse);border-radius:var(--radius-md);border:1px solid var(--border-dark)}
  .odc .closer p{font-size:.98rem;color:var(--muted-inverse)}
  .odc .closer p+p{margin-top:10px}
  .odc .closer strong{color:var(--lime)}

  /* ============ STEPS ============ */
  .odc .steps-grid{margin-top:44px;display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .odc .step .snum{font-family:"Bricolage Grotesque",sans-serif;font-weight:900;font-size:2.6rem;line-height:1;-webkit-text-stroke:1.5px var(--muted);color:transparent}
  .odc .step h3{margin-top:10px;font-size:1.08rem}
  .odc .step p{margin-top:8px;color:var(--muted);font-size:.94rem}

  /* ============ FAQ ============ */
  .odc .faq{background:var(--bg)}
  .odc .faq-list{margin-top:36px;display:grid;gap:10px;max-width:820px}
  .odc details{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-md);padding:4px 20px;overflow:hidden;margin:0}
  .odc summary{cursor:pointer;list-style:none;padding:16px 0;display:flex;justify-content:space-between;align-items:center;gap:16px;font-family:"Bricolage Grotesque",sans-serif;font-weight:700;font-size:1rem;line-height:1.3}
  .odc summary::-webkit-details-marker{display:none}
  .odc summary::marker{content:""}
  .odc summary .chev{flex:none;width:26px;height:26px;border-radius:50%;background:var(--bg);display:flex;align-items:center;justify-content:center;transition:transform .25s ease,background .25s ease}
  .odc summary .chev svg{width:11px;height:11px}
  .odc details[open] summary .chev{transform:rotate(45deg);background:var(--lime)}
  .odc details .ans{padding-bottom:18px;color:var(--muted);font-size:.96rem;max-width:65ch}

  /* ============ FINAL CTA ============ */
  .odc .final{background:radial-gradient(70% 90% at 50% 0%,rgba(255,46,139,0.28),transparent 60%),var(--bg-dark);color:var(--ink-inverse);text-align:center}
  .odc .final .eyebrow{justify-content:center}
  .odc .final h2{max-width:22ch;margin:14px auto 0;color:var(--ink-inverse);font-size:clamp(2rem,4.6vw,3.1rem)}
  .odc .final .lede{margin-inline:auto;text-align:center;color:var(--muted-inverse)}
  .odc .final .lede strong{color:var(--lime)}
  .odc .final .btn{margin-top:30px}

  .odc .odc-footer{background:var(--bg-dark-2);color:var(--muted-inverse);padding-block:40px;font-size:.82rem}
  .odc .foot-grid{display:flex;flex-wrap:wrap;gap:14px 24px;justify-content:space-between;align-items:center}
  .odc .foot-links{display:flex;flex-wrap:wrap;gap:10px 18px}
  .odc .foot-links a{text-decoration:none;opacity:.85;padding:4px 0}
  .odc .foot-links a:hover{opacity:1;color:var(--lime)}

  /* ============ MOBILE STICKY CTA ============ */
  .odc .mcta{
    position:fixed;left:0;right:0;bottom:0;z-index:60;display:none;
    padding:10px 14px calc(10px + env(safe-area-inset-bottom));
    background:rgba(18,11,30,0.92);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);
    border-top:1px solid var(--border-dark);
    transform:translateY(110%);transition:transform .3s ease;
  }
  .odc .mcta.is-visible{transform:translateY(0)}
  .odc .mcta .btn{width:100%;padding:0.95rem}

  @media (max-width:920px){
    .odc .hero-grid{grid-template-columns:1fr;gap:24px}
    .odc .phone-stage{height:380px;max-width:400px;width:100%;margin-inline:auto}
    .odc .phone{width:180px}
    .odc .toast1{left:0}
    .odc .toast2{right:0}
    .odc .toast3{right:2%}
    .odc .stats-grid{grid-template-columns:1fr}
    .odc .modules-grid{grid-template-columns:repeat(2,1fr)}
    .odc .extra-list{grid-template-columns:1fr}
    .odc .notneed-grid{grid-template-columns:1fr 1fr}
    .odc .calc-wrap{grid-template-columns:1fr}
    .odc .calc-stage{order:-1;height:200px}
    .odc .offer-grid{grid-template-columns:1fr}
    .odc .price-card{grid-template-columns:1fr;text-align:center}
    .odc .price-lines{max-width:340px;margin-inline:auto}
    .odc .story-grid{grid-template-columns:1fr}
    .odc .photo-card{margin-inline:auto;width:80%;max-width:300px}
    .odc .steps-grid{grid-template-columns:1fr}
    .odc{padding-bottom:78px}
    .odc .mcta{display:block}
  }
  @media (max-width:560px){
    .odc .hero-cta{align-items:stretch}
    .odc .hero-cta .btn{width:100%}
    .odc .hero-cta .btn-sub{text-align:center}
    .odc .trust-row{justify-content:center}
    .odc .modules-grid{grid-template-columns:1fr}
    .odc .notneed-grid{grid-template-columns:1fr}
    .odc .announce{font-size:.74rem;padding-block:8px}
    .odc .toast{width:180px;font-size:.72rem}
    .odc .toast3{width:130px}
    .odc .bonus{grid-template-columns:auto 1fr;}
    .odc .bonus .val{grid-column:2;justify-self:start;margin-top:-6px}
    .odc .story .btn,.odc .final .btn{width:100%}
  }
  @media (prefers-reduced-motion:reduce){
    .odc .blob,.odc .toast{animation:none}
    .odc .bill,.odc .mcta,.odc .btn,.odc .phone{transition:none}
  }
</style>

{%- capture icon_check -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{%- endcapture -%}
{%- capture icon_plus -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>{%- endcapture -%}
{%- capture icon_lock -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>{%- endcapture -%}
{%- capture icon_bolt -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z"/></svg>{%- endcapture -%}

<div class="odc" id="odc-{{ section.id }}"
  data-price="{{ s.price_usd }}"
  data-ars-rate="{{ s.ars_rate }}"
  {% if s.countdown_date != blank %}data-deadline="{{ s.countdown_date | strip }}T{{ s.countdown_time | default: '23:59' | strip }}:00{{ s.countdown_utc_offset | default: '-03:00' | strip }}"{% endif %}>

  {%- if s.show_announce -%}
    <div class="announce{% if s.countdown_date == blank %} is-expired{% endif %}" role="region" aria-label="Oferta">
      <span class="when-live">⏰ {{ s.announce_text | replace: '[descuento]', pct_str | replace: '[precio]', price_str }}</span>
      <span class="when-expired">{{ s.announce_text_expired | replace: '[descuento]', pct_str | replace: '[precio]', price_str }}</span>
      {%- if s.countdown_date != blank -%}
        <span class="countdown mono when-live" aria-live="off">
          <span class="t" data-cd="d" hidden>00d</span><span class="sep" data-cd="dsep" hidden>:</span>
          <span class="t" data-cd="h">--</span><span class="sep">:</span><span class="t" data-cd="m">--</span><span class="sep">:</span><span class="t" data-cd="s">--</span>
        </span>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if hero_b -%}
  <header class="hero" {{ hero_b.shopify_attributes }}>
    <div class="blob blob1" aria-hidden="true"></div>
    <div class="blob blob2" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">{{ hero_b.settings.hero_eyebrow }}</span>
        <h1>{{ hero_b.settings.hero_title }}</h1>
        <p class="lede">{{ hero_b.settings.hero_text }}</p>
        <div class="hero-cta" data-odc-hero-cta>
          <a class="btn" href="{{ cta_url }}">{{ hero_b.settings.cta_hero | replace: '[precio]', price_str }}</a>
          <span class="btn-sub">{{ hero_b.settings.cta_sub }}{% if cuotas_str != blank %} · <strong>{{ cuotas_str }}</strong>{% endif %}</span>
        </div>
        <div class="trust-row">
          {%- if hero_b.settings.trust_1 != blank -%}<span>{{ icon_check }}{{ hero_b.settings.trust_1 }}</span>{%- endif -%}
          {%- if hero_b.settings.trust_2 != blank -%}<span>{{ icon_check }}{{ hero_b.settings.trust_2 }}</span>{%- endif -%}
          {%- if hero_b.settings.trust_3 != blank -%}<span>{{ icon_check }}{{ hero_b.settings.trust_3 }}</span>{%- endif -%}
        </div>
      </div>
      <div class="phone-stage" data-odc-stage aria-hidden="true">
        <div class="phone" data-odc-phone>
          <div class="screen">
            <div class="screen-glow"></div>
            <div class="screen-price">{{ hero_b.settings.phone_amount }}</div>
            <div class="screen-sub">{{ hero_b.settings.phone_label }}</div>
            <div class="screen-bars">
              <i style="height:35%"></i><i style="height:55%"></i><i style="height:40%"></i>
              <i style="height:75%"></i><i style="height:60%"></i><i style="height:90%"></i>
              <i style="height:50%"></i>
            </div>
          </div>
        </div>
        {%- if hero_b.settings.toast1_name != blank -%}<div class="toast toast1"><div class="av">{{ hero_b.settings.toast1_name | slice: 0 | upcase }}</div><div><b>{{ hero_b.settings.toast1_name }}</b><span class="ok">{{ hero_b.settings.toast1_text }}</span></div></div>{%- endif -%}
        {%- if hero_b.settings.toast2_name != blank -%}<div class="toast toast2"><div class="av">{{ hero_b.settings.toast2_name | slice: 0 | upcase }}</div><div><b>{{ hero_b.settings.toast2_name }}</b><span class="ok">{{ hero_b.settings.toast2_text }}</span></div></div>{%- endif -%}
        {%- if hero_b.settings.toast3_name != blank -%}<div class="toast toast3"><div class="av">$</div><div><b>{{ hero_b.settings.toast3_name }}</b><span class="ok">{{ hero_b.settings.toast3_text }}</span></div></div>{%- endif -%}
      </div>
    </div>
  </header>
  {%- endif -%}

  {%- if stats_b -%}
  <section class="stats" aria-label="Resultados" {{ stats_b.shopify_attributes }}>
    <div class="wrap">
      <div class="stats-grid">
        <div class="stat"><div class="num mono">{{ stats_b.settings.stat1_num }}</div><div class="lbl">{{ stats_b.settings.stat1_label }}</div></div>
        <div class="stat"><div class="num mono">{{ stats_b.settings.stat2_num }}</div><div class="lbl">{{ stats_b.settings.stat2_label }}</div></div>
        <div class="stat"><div class="num mono">{% if stats_b.settings.stat3_num == blank %}{{ price_str }}{% else %}{{ stats_b.settings.stat3_num }}{% endif %}</div><div class="lbl">{{ stats_b.settings.stat3_label | replace: '[cuotas]', cuotas_str }}</div></div>
      </div>
    </div>
  </section>
  {%- endif -%}

  <section class="agitate dark section-pad">
    <div class="wrap">
      <span class="eyebrow">{{ s.pain_eyebrow }}</span>
      <h2 class="headline">{{ s.pain_title }}</h2>
      <div class="agitate-list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'pain' -%}
            <div class="pain" {{ block.shopify_attributes }}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l3 2"/></svg><p>{{ block.settings.text }}</p></div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="modules section-pad">
    <div class="wrap">
      <span class="eyebrow">{{ s.modules_eyebrow }}</span>
      <h2 class="headline">{{ s.modules_title }}</h2>
      {%- if s.modules_text != blank -%}<p class="lede">{{ s.modules_text }}</p>{%- endif -%}
      {%- assign mod_i = 0 -%}
      {%- capture modules_html -%}{%- endcapture -%}
      {%- capture extras_html -%}{%- endcapture -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'module' or block.type == 'extra' -%}
          {%- capture ico -%}
            {%- case block.settings.icon -%}
              {%- when 'layers' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2 3 7l9 5 9-5-9-5Z"/><path d="M3 12l9 5 9-5"/></svg>
              {%- when 'plus' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2v20M2 12h20"/></svg>
              {%- when 'page' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
              {%- when 'gear' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19 12a7 7 0 0 0-.1-1.2l2-1.5-2-3.4-2.3.9a7 7 0 0 0-2.1-1.2L14 3h-4l-.5 2.6a7 7 0 0 0-2.1 1.2l-2.3-.9-2 3.4 2 1.5a7 7 0 0 0 0 2.4l-2 1.5 2 3.4 2.3-.9a7 7 0 0 0 2.1 1.2L10 21h4l.5-2.6a7 7 0 0 0 2.1-1.2l2.3.9 2-3.4-2-1.5c.1-.4.1-.8.1-1.2Z"/></svg>
              {%- when 'instagram' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="1"/></svg>
              {%- when 'heart' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9Z"/></svg>
              {%- when 'dollar' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              {%- when 'trend' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m4 15 6-6 4 4 6-8"/><path d="M20 3v6h-6"/></svg>
              {%- when 'star' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2 15 9l7 1-5 5 1.5 7L12 18l-6.5 4L7 15 2 10l7-1 3-7Z"/></svg>
              {%- when 'book' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>
              {%- when 'sun' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8"/></svg>
              {%- when 'calendar' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
              {%- when 'bulb' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 3 2 4.5 2 7h10c0-2.5 2-4 2-7a7 7 0 0 0-7-7Z"/><path d="M9 21h6"/></svg>
              {%- when 'video' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="5" width="14" height="14" rx="2"/><path d="m16 10 6-3v10l-6-3"/></svg>
              {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            {%- endcase -%}
          {%- endcapture -%}
          {%- if block.type == 'module' -%}
            {%- assign mod_i = mod_i | plus: 1 -%}
            {%- capture modules_html -%}{{ modules_html }}<div class="mcard" data-odc-tilt {{ block.shopify_attributes }}><span class="num">{% if mod_i < 10 %}0{% endif %}{{ mod_i }}</span><div class="micon">{{ ico }}</div><h3>{{ block.settings.title }}</h3>{% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}</div>{%- endcapture -%}
          {%- else -%}
            {%- capture extras_html -%}{{ extras_html }}<div class="extra" {{ block.shopify_attributes }}>{{ ico }}{{ block.settings.title }}</div>{%- endcapture -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      <div class="modules-grid">{{ modules_html }}</div>
      {%- if extras_html != blank -%}<div class="extra-list">{{ extras_html }}</div>{%- endif -%}
    </div>
  </section>

  <section class="notneed dark section-pad">
    <div class="wrap">
      <span class="eyebrow">{{ s.notneed_eyebrow }}</span>
      <h2 class="headline">{{ s.notneed_title }}</h2>
      <ul class="notneed-grid" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'notneed' -%}
            <li class="nn" {{ block.shopify_attributes }}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>{{ block.settings.text }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>

  {%- if calc_b -%}
  <section class="calc dark section-pad" {{ calc_b.shopify_attributes }}>
    <div class="wrap calc-wrap">
      <div class="calc-copy">
        <span class="eyebrow">{{ calc_b.settings.calc_eyebrow }}</span>
        <h2 class="headline">{{ calc_b.settings.calc_title }}</h2>
        <p class="lede">{{ calc_b.settings.calc_text | replace: '[precio]', price_str }}</p>
        <div class="calc-controls">
          <div class="calc-value"><span class="v mono" data-odc-sales>10</span><span class="calc-unit">ventas por mes</span></div>
          <input type="range" min="1" max="100" step="1" value="10" data-odc-range aria-label="Ventas por mes">
          <div class="calc-result" aria-live="polite">
            <div class="res-row big"><span>Ingresos al mes</span><span class="mono" data-odc-usd>${{ s.price_usd | times: 10 }} USD</span></div>
            {%- if s.ars_rate > 0 -%}<div class="res-row"><span></span><span class="mono" data-odc-ars></span></div>{%- endif -%}
          </div>
